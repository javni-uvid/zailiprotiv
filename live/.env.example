# Copy to .env. Everything has a default (uzivo/config.py); these are the ones worth knowing.
PUBLIC_URL=https://mikrofon.zailiprotiv.rs/
# YOUTUBE_URL=https://www.youtube.com/watch?v=...   # only while the broadcaster's page can't be read; the page wins
# YTDLP_COOKIES=/data/cookies.txt                   # when YouTube asks to sign in
# HOLD_SECONDS=25
# WHISPER_MODEL=           # empty turns the automatic transcript off (the one model is large-v3-turbo)
# WHISPER_THREADS=4        # cores it may use
# WHISPER_URL=             # whisper.cpp's server on the graphics card (live/whisper-gpu.ps1); the compose files say
#                          # http://host.docker.internal:8178, empty here writes on the CPU only
# GLAS=0            # who speaks by the voice off (glas.py); GLAS_BEZ: names never named by voice (the chairs)
# TITL_PRIKAZ=0     # the line under the broadcast's picture off (on by default; needs WHISPER_URL, the graphics card)
# TITL_KASNJENJE=0  # seconds the page holds a new line of it, to come with the viewer's picture
# PREPIS_PRIKAZ=1   # show the automatic transcript on the page (off: it is written down, not shown)
# PREPIS_SAMO_PREDSEDAVAJUCI=1   # write only the chair's sound down (for the day's steps); by default the speakers' too
# PREPIS_KLJUC=   # at least 12 characters: /prepis?k=<this> shows the transcript to whoever has it, while it is off the page

# The model that tells the day's steps and sums the day up (uzivo/sudija.py): its key, which model, and whether the
# summary is on the page (until then /sazetak?k=<PREPIS_KLJUC>). No key: nothing is sent, the rules tell the steps.
# ANTHROPIC_API_KEY=   # in live/.env only, never committed
# HAIKU_MODEL=claude-haiku-5-5
# SAZETAK_PRIKAZ=1   # the summary on the page
