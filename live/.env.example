# Copy to .env. Everything has a default (uzivo/config.py); these are the ones worth knowing.
PUBLIC_URL=https://mikrofon.zailiprotiv.rs/
# YOUTUBE_URL=https://www.youtube.com/watch?v=...   # only while the broadcaster's page can't be read; the page wins
# YTDLP_COOKIES=/data/cookies.txt                   # when YouTube asks to sign in
# HOLD_SECONDS=25
# WHISPER_MODEL=small      # the automatic transcript: small (default), medium (better, slower), or empty for off
# WHISPER_THREADS=4        # cores it may use
# WHISPER_FINAL_MODEL=medium   # each finished speech written down again by a better model (slower; off by default)
# PREPIS_PRIKAZ=1   # show the automatic transcript on the page (off: it is written down, not shown)
# PREPIS_SAMO_PREDSEDAVAJUCI=1   # write only the chair's sound down (for the day's steps); by default the speakers' too
# PREPIS_KLJUC=   # at least 12 characters: /prepis?k=<this> shows the transcript to whoever has it, while it is off the page
